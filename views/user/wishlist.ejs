<div class="wishlist-container">
  <h2 class="wishlist-title">My Wishlist</h2>
  <table class="wishlist-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Availability</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% wishlistItems.forEach(item => { %>
        <tr data-id="<%=item.id%>">
          <td class="product-info">
            <img src="<%= item.image %>" alt="<%= item.name %>" />
            <div class="product-details">
              <span class="product-name"><%= item.name %></span>
            </div>
          </td>
          <td class="price">Rs.<%= item.price %></td>
       
              <td class="availability">
          <% if(item.stock>0) { %>
              <span class="badge in-stock">✓ In Stock</span>
            <% } else { %>
              <span class="badge out-of-stock">✗ Out of Stock</span>
            <% } %>
          </td>
          <td class="action-buttons">
            <button class="add-btn" data-id="<%= item.id %>" <%= item.stock <= 0 ? 'disabled' : '' %>>Add to Cart</button>
            <button class="remove-btn" data-id="<%= item.id %>">Remove</button>
          </td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4" class="wishlist-summary">
          <span><%= wishlistItems.length %> items in wishlist</span>
          <span class="stock-summary">
            (<%= wishlistItems.filter(item => item.inStock).length %> in stock, 
            <%= wishlistItems.filter(item => !item.inStock).length %> out of stock)
          </span>
        </td>
      </tr>
    </tfoot>
  </table>
</div>

