<div class="wishlist-container">
  <h2 class="wishlist-title">My Wishlist</h2>

  <% if (wishlistItems && wishlistItems.length> 0) { %>
    <table class="wishlist-table">
      <colgroup>
        <col style="width: 40%">
        <col style="width: 15%">
        <col style="width: 20%">
        <col style="width: 25%">
      </colgroup>
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th style="text-align:center;">Availability</th>
          <th style="text-align:center;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% wishlistItems.forEach(item=> { %>
          <tr data-id="<%= item.id %>">
            <td>
              <div class="product-info">
                <img src="<%= item.image %>" alt="<%= item.name %>" />
                <div class="product-details">
                  <span class="product-name">
                    <%= item.name %>
                  </span>
                </div>
              </div>
            </td>
            <td class="price">Rs.<%= item.price %>
            </td>
            <td class="availability">
              <% if (item.stock> 0) { %>
                <span class="badge in-stock">✓ In Stock</span>
                <% } else { %>
                  <span class="badge out-of-stock">✗ Out of Stock</span>
                  <% } %>
            </td>
            <td>
              <div class="action-buttons">
                <button class="add-btn" data-id="<%= item.id %>" <%=item.stock <=0 ? 'disabled' : '' %>>Add to
                  Cart</button>
                <button class="remove-btn" data-id="<%= item.id %>">Remove</button>
              </div>
            </td>
          </tr>
          <% }); %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" class="wishlist-summary">
            <span>
              <%= wishlistItems.length %> items in wishlist
            </span>
            <span class="stock-summary">
              (<%= wishlistItems.filter(item=> item.stock > 0).length %> in stock,
                <%= wishlistItems.filter(item=> item.stock <= 0).length %> out of stock)
            </span>
          </td>
        </tr>
      </tfoot>
    </table>

    <% } else { %>

      <div class="empty-wishlist">
        <h3>Your wishlist is empty</h3>
        <p>Add products to your wishlist to see them here.</p>
      </div>

      <% } %>
</div>