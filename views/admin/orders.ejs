<%- include('../partials/admin/admin-header') %>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin/order.css">

  <div class="container">
    <h1>Orders Management</h1>

    <div class="filter-section">
      <form id="filterForm" method="GET" action="/admin/orders">
        <div class="filter-row">
          <div class="search-box">
            <input type="text" name="search" placeholder="Search by Order ID/User" class="search-input"
              value="<%= searchQuery %>" />
            <button type="submit" class="order-search-btn">
              <i class="fas fa-search"></i> Search
            </button>
          </div>

          <div class="filter-controls">
            <div class="filter-group">
              <label for="status">Status:</label>
              <select name="status" id="status" class="filter-select">
                <option value="">All Statuses</option>
                <option value="Pending" <%=statusFilter==='Pending' ? 'selected' : '' %>>Pending</option>
                <option value="Processing" <%=statusFilter==='Processing' ? 'selected' : '' %>>processing</option>


                <option value="Shipped" <%=statusFilter==='Shipped' ? 'selected' : '' %>>Shipped</option>
                <option value="Delivered" <%=statusFilter==='Delivered' ? 'selected' : '' %>>Delivered</option>
                <option value="Cancelled" <%=statusFilter==='Cancelled' ? 'selected' : '' %>>Cancelled</option>
                <option value="Returned" <%=statusFilter==='Returned' ? 'selected' : '' %>>Returned</option>
              </select>
            </div>

            <div class="filter-group">
              <label for="sort">Sort By:</label>
              <select name="sort" id="sort" class="filter-select">
                <option value="newest" <%=sortOption==='newest' ? 'selected' : '' %>>Newest First</option>
                <option value="oldest" <%=sortOption==='oldest' ? 'selected' : '' %>>Oldest First</option>
                <option value="highest" <%=sortOption==='highest' ? 'selected' : '' %>>Highest Amount</option>
                <option value="lowest" <%=sortOption==='lowest' ? 'selected' : '' %>>Lowest Amount</option>
              </select>
            </div>

            <div class="filter-group date-range-group">
              <label>Date Range:</label>
              <div class="date-inputs">
                <input type="date" name="startDate" id="startDate" class="date-input" value="<%= startDate %>"
                  placeholder="From" />
                <span>to</span>
                <input type="date" name="endDate" id="endDate" class="date-input" value="<%= endDate %>"
                  placeholder="To" />
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="apply-btn">
                <i class="fas fa-filter"></i> Apply
              </button>
              <a href="/admin/orders" class="reset-btn">
                <i class="fas fa-redo"></i> Reset
              </a>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div class="table-container">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>User</th>
              <th>Date</th>
              <th>Total</th>
              <th>Status</th>
              <th>Return Request</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <!-- <pre><%= JSON.stringify(orders) %></pre> -->

            <% if (orders.length> 0) { %>
              <% orders.forEach(order=> { %>
                <tr data-order-id="<%= order.orderId %>">
                  <td data-label="ID">#<%= order.orderId %>
                  </td>
                  <td data-label="User">
                    <%= order.user %>
                  </td>
                  <td data-label="Date">
                    <%= order.date %>
                  </td>
                  <td data-label="Total">₹<%= order.originalTotal || order.total %>
                  </td>
                  <td data-label="Status">
                    <span class="status <%= order.statusClass %>">
                      <%= order.status %>
                    </span>
                  </td>
                  <td data-label="Return Request">
                    <% if (order.status==='delivered' && order.returnRequest===true
                      ||order.status==='partially_returned' &&
                      order.returnRequest===true||order.status==='return_requested' ) { %>
                      <button class="verify-btn" data-order-id="<%= order.orderId%>">
                        <i class="fas fa-check-circle"></i> Verify
                      </button>
                      <% } else { %>
                        <span class="no-request">-</span>
                        <% } %>
                  </td>
                  <td data-label="Actions" class="actions-cell">

                    <button class="view-btn" data-order-id="<%= order.orderId %>">
                      <i class="fas fa-eye"></i> View
                    </button>

                    <!-- <pre><%= JSON.stringify(order) %></pre> -->

                    <button class="change-btn" data-order-id="<%= order.id %>" <% if (order.status==='cancelled' ||
                      order.status==='returned' ) { %>
                      disabled
                      <% } %>
                        >
                        <i class="fas fa-edit"></i> Change
                    </button>


                  </td>
                </tr>
                <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="no-orders">No orders found matching your criteria</td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (totalPages> 1) { %>
      <div class="pagination">
        <% if (currentPage> 1) { %>
          <a href="<%= buildPaginationUrl(1) %>" class="page-link first-page">
            <i class="fas fa-angle-double-left"></i>
          </a>
          <a href="<%= buildPaginationUrl(currentPage - 1) %>" class="page-link prev-page">
            <i class="fas fa-angle-left"></i> Previous
          </a>
          <% } %>

            <% const maxVisiblePages=5; let startPage=Math.max(1, currentPage - Math.floor(maxVisiblePages / 2)); let
              endPage=Math.min(totalPages, startPage + maxVisiblePages - 1); if (endPage - startPage + 1 <
              maxVisiblePages) { startPage=Math.max(1, endPage - maxVisiblePages + 1); } %>

              <% if (startPage> 1) { %>
                <span class="page-dots">...</span>
                <% } %>

                  <% for (let i=startPage; i <=endPage; i++) { %>
                    <a href="<%= buildPaginationUrl(i) %>" class="page-link <%= i === currentPage ? 'active' : '' %>">
                      <%= i %>
                    </a>
                    <% } %>

                      <% if (endPage < totalPages) { %>
                        <span class="page-dots">...</span>
                        <% } %>

                          <% if (currentPage < totalPages) { %>
                            <a href="<%= buildPaginationUrl(currentPage + 1) %>" class="page-link next-page">
                              Next <i class="fas fa-angle-right"></i>
                            </a>
                            <a href="<%= buildPaginationUrl(totalPages) %>" class="page-link last-page">
                              <i class="fas fa-angle-double-right"></i>
                            </a>
                            <% } %>
      </div>
      <% } %>
  </div>
  <div id="toast-container"></div>
  <!-- Return Request Modal (Full with IDs) -->
  <div class="modal-overlay" id="returnRequestModal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Return Request Details</h3>
        <button type="button" class="close-btn" onclick="closeReturnModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="return-details">
          <div class="detail-row">
            <span class="detail-label">Order ID:</span>
            <span class="detail-value" id="returnOrderId"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Customer:</span>
            <span class="detail-value" id="returnCustomer"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Order Date:</span>
            <span class="detail-value" id="returnOrderDate"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Order Total:</span>
            <span class="detail-value" id="returnOrderTotal"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Return Reason:</span>
            <span class="detail-value" id="returnReason"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Additional Notes:</span>
            <span class="detail-value" id="returnNotes"></span>
          </div>
        </div>

        <div class="return-items-section">
          <div class="detail-row">
            <span class="detail-label">Returning Items:</span>
          </div>
          <div class="full-return-msg">
            <ul id="returnItemsListFull" class="return-items-list">
              <li><em>Full order return requested</em></li>
            </ul>
          </div>
          <div class="partial-items">
            <ul id="returnItemsListPartial" class="return-items-list">
              <!--Items will be dynamically added here -->
            </ul>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <div class="global-btns">
          <button type="button" class="btn btn-danger" onclick="processReturn('reject-all')">Reject Full Return</button>
          <button type="button" class="btn btn-success" onclick="processReturn('approve-all')">Approve Full
            Return</button>
        </div>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      console.log("Script loaded - DOM ready");

      // Elements
      const filterForm = document.getElementById('filterForm');
      const searchInput = document.querySelector('.search-input');
      const statusSelect = document.getElementById('status');
      const sortSelect = document.getElementById('sort');
      const startDateInput = document.getElementById('startDate');
      const endDateInput = document.getElementById('endDate');
      const verifyButtons = document.querySelectorAll('.verify-btn');
      const viewButtons = document.querySelectorAll('.view-btn');
      const changeButtons = document.querySelectorAll('.change-btn');
      console.log("Buttons found:", { verify: verifyButtons.length, view: viewButtons.length, change: changeButtons.length });

      // Date input validation
      if (startDateInput && endDateInput) {
        const today = new Date().toISOString().split('T')[0];
        startDateInput.max = today;
        endDateInput.max = today;

        startDateInput.addEventListener('change', function () {
          endDateInput.min = this.value;
          if (endDateInput.value < this.value) endDateInput.value = this.value;
        });
        endDateInput.addEventListener('change', function () {
          if (startDateInput.value && this.value < startDateInput.value) this.value = startDateInput.value;
        });
      }

      // Filter form submit
      if (filterForm) {
        filterForm.addEventListener('submit', function (e) {
          e.preventDefault();
          const formData = new FormData(this);
          const params = new URLSearchParams();
          formData.forEach((value, key) => { if (value) params.append(key, value); });
          params.set('page', '1');
          window.location.href = `${this.action}?${params.toString()}`;
        });
      }

      // View buttons
      viewButtons.forEach(button => {
        button.addEventListener('click', function () {
          const orderId = this.dataset.orderId;
          console.log('View clicked:', orderId);
          window.location.href = `/admin/orders/${orderId}/view`;
        });
      });

      // Change status buttons
      changeButtons.forEach(button => {
        button.addEventListener('click', function () {
          console.log("Change button clicked");
          const row = this.closest('tr');
          const orderId = this.dataset.orderId;
          console.log("Order ID:", orderId);

          const existingDropdown = row.querySelector('.status-dropdown');
          if (existingDropdown) {
            existingDropdown.remove();
            return;
          }

          const currentStatus = row.querySelector('.status').textContent.trim();
          const statusOptions = ['Pending', 'Processing', 'Shipped', 'Delivered'];  // Capitalized to match EJS

          const select = document.createElement('select');
          select.className = 'status-dropdown';
          statusOptions.forEach(status => {
            let isDisabled = false;
            const currentLower = currentStatus.toLowerCase();
            const targetLower = status.toLowerCase();

            if (currentLower === 'pending') {
              isDisabled = (targetLower === 'cancelled' || targetLower === 'returned');
            } else if (currentLower === 'processing') {
              isDisabled = (targetLower === 'pending');
            } else if (currentLower === 'shipped') {
              isDisabled = (targetLower === 'pending' || targetLower === 'processing');
            } else if (currentLower === 'delivered') {
              isDisabled = (targetLower === 'pending' || targetLower === 'processing' || targetLower === 'shipped');
            }

            const option = document.createElement('option');
            option.value = status;
            option.textContent = status;
            if (targetLower === currentLower) option.selected = true;
            if (isDisabled) option.disabled = true;
            select.appendChild(option);
          });

          this.parentElement.appendChild(select);

          select.addEventListener('change', function () {
            const newStatus = this.value;
            console.log("New status:", newStatus);
            if (newStatus.toLowerCase() === currentStatus.toLowerCase()) return;

            fetch(`/admin/orders/${orderId}/status`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: newStatus.toLowerCase() })
            })
              .then(res => res.json())
              .then(data => {
                if (data.error) {
                  showToast(`Error: ${data.error}`, 'error');
                } else {
                  const statusEl = row.querySelector('.status');
                  if (statusEl) {
                    statusEl.textContent = data.status;
                    statusEl.className = `status ${data.statusClass}`;
                  }
                  showToast('Status updated', 'success');
                }
                select.remove();
              })
              .catch(err => {
                console.error(err);
                showToast('Failed to update', 'error');
                select.remove();
              });
          });
        });
      });

      // Helper: Populate common order details (always shown) - with null guards
      function populateOrderDetails(customOrderId, customer, orderDate, orderTotal, data) {
        const elements = {
          returnOrderId: document.getElementById('returnOrderId'),
          returnCustomer: document.getElementById('returnCustomer'),
          returnOrderDate: document.getElementById('returnOrderDate'),
          returnOrderTotal: document.getElementById('returnOrderTotal'),
          returnReason: document.getElementById('returnReason'),
          returnNotes: document.getElementById('returnNotes')
        };

        const missing = [];
        for (const [key, el] of Object.entries(elements)) {
          if (!el) missing.push(`#${key}`);
        }
        if (missing.length > 0) {
          console.warn('Missing modal elements:', missing);
          return;
        }

        console.log('Populating order details:', { customOrderId, customer, orderDate, orderTotal });
        elements.returnOrderId.textContent = `#${customOrderId}`;
        elements.returnCustomer.textContent = customer;
        elements.returnOrderDate.textContent = orderDate;
        elements.returnOrderTotal.textContent = orderTotal;
        elements.returnReason.textContent = data.reason || 'Not specified';
        elements.returnNotes.textContent = data.notes || 'None';
      }
      function populateItemsSection(data) {
        console.log("inside the populate item");

        const itemsSection = document.querySelector('.return-items-section');
        const fullMsg = itemsSection.querySelector('.full-return-msg');
        const partialContainer = itemsSection.querySelector('.partial-items');
        const fullList = document.getElementById('returnItemsListFull');
        const partialList = document.getElementById('returnItemsListPartial');
        const globalBtns = document.querySelector('.modal-footer .global-btns');

        const isFullReturn = data.type === 'full';
        console.log(
          "Return type detected:",
          isFullReturn ? 'full' : 'partial',
          "Items count:",
          data.items?.length
        );

        itemsSection.classList.remove('show-full', 'show-partial');

        if (fullList) fullList.innerHTML = '';
        if (partialList) partialList.innerHTML = '';

        if (isFullReturn) {
          itemsSection.classList.add('show-full');

          if (partialContainer) partialContainer.style.display = 'none';
          if (fullMsg) fullMsg.style.display = 'block';

          if (globalBtns) {
            globalBtns.classList.remove('hidden');
            globalBtns.style.display = 'inline-block';
          }

          if (fullList) {
            if (data.items && data.items.length > 0) {
              data.items.forEach(item => {
                const li = document.createElement('li');
                li.className = 'return-item';

                li.innerHTML = `
            <div class="item-details">
              <div class="item-name">${item.name}</div>
              <div class="item-info">
                <span><strong>Qty:</strong> ${item.quantity}</span> |
                <span><strong>Price:</strong> ₹${item.price || 'N/A'}</span><br>
                <span><strong>Reason:</strong> ${item.reason || data.reason || 'Not specified'}</span>
              </div>
            </div>
            <div class="item-controls">
              <span class="return-status badge-warning">Pending</span>
            </div>
          `;

                fullList.appendChild(li);
              });
            } else {
              fullList.innerHTML = '<li><em>Full order return requested</em></li>';
            }
          }

          return;
        }

        itemsSection.classList.add('show-partial');

        if (fullMsg) fullMsg.style.display = 'none';
        if (partialContainer) partialContainer.style.display = 'block';

        if (globalBtns) {
          globalBtns.classList.add('hidden');
          globalBtns.style.display = 'none';
        }

        if (partialList) {
          if (data.items && data.items.length > 0) {
            data.items.forEach(item => {
              const li = document.createElement('li');
              li.className = 'return-item';

              const itemId = item._id || item.product;
              li.dataset.itemId = itemId;

              li.innerHTML = `
          <div class="item-details">
            <div class="item-name">${item.name}</div>
            <div class="item-info">
              <span><strong>Qty:</strong> ${item.quantity}</span> |
              <span><strong>Price:</strong> ₹${item.price || 'N/A'}</span><br>
              <span><strong>Reason:</strong> ${item.reason || data.reason || 'Not specified'}</span>
            </div>
          </div>
          <div class="item-controls">
            <span class="return-status badge-warning">Pending</span>
            <div class="item-actions">
              <button class="btn btn-success btn-sm" onclick="processReturn('approve', '${itemId}')">Approve</button>
              <button class="btn btn-danger btn-sm" onclick="processReturn('reject', '${itemId}')">Reject</button>
            </div>
          </div>
        `;

              partialList.appendChild(li);
            });
          } else {
            partialList.innerHTML = '<li><em>No items specified</em></li>';
          }
        }
      }

      function showReturnModal(orderId) {
        console.log("inside the showreturn modal");
        const modal = document.getElementById('returnRequestModal');
        modal.dataset.orderId = orderId;
        modal.classList.add('active');

      }

      verifyButtons.forEach(button => {
        button.addEventListener('click', function (e) {
          e.stopPropagation();
          const row = this.closest('tr');
          if (!row) return;

          const orderId = this.dataset.orderId;
          console.log("Order ID from dataset:", orderId);

          const customOrderId = row.querySelector('td:first-child').textContent.substring(1);
          const customer = row.querySelector('td:nth-child(2)').textContent;
          const orderDate = row.querySelector('td:nth-child(3)').textContent;
          const orderTotal = row.querySelector('td:nth-child(4)').textContent;

          this.textContent = 'Loading...';
          this.disabled = true;

          fetch(`/admin/orders/${orderId}/verify-return`)
            .then(async (response) => {
              console.log("response status:", response.status);
              console.log("response ok:", response.ok);

              if (!response.ok) {
                let errorMessage = "failed to fetch return details";
                try {
                  const errorData = await response.json();
                  console.error("backed error", errorData);
                  errorMessage = errorData.message ||
                    errorData.error ||
                    errorMessage;
                } catch (error) {
                  console.error("failed to parse error response:", error);
                }
                showToast(errorMessage, 'error');
                throw new Error(errorMessage);
              }
              return response.json();

            })
            .then(data => {
              console.log("the data inside the verify:", data);
              const modal = document.getElementById('returnRequestModal');
              modal.dataset.orderId = orderId;
              if (data.returnType === 'partial' && data.items?.length) {
                modal.dataset.itemIds = JSON.stringify(
                  data.items.map(item => item.itemId)
                )
              }
              populateOrderDetails(customOrderId, customer, orderDate, orderTotal, data);
              populateItemsSection(data);
              showReturnModal(orderId);
            })
            .catch(error => {
              console.error('Error:', error);
              Swal.fire({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true, icon: 'error', title: `Failed to load return details: ${error.message}` });
            })
            .finally(() => {
              this.innerHTML = '<i class="fas fa-check-circle"></i> Verify';
              this.disabled = false;
            });
        });
      });

      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
          e.preventDefault();
          searchInput?.focus();
        }
      });
    });

    function closeReturnModal() {
      console.log("hi inside the close modal");
      const modal = document.getElementById('returnRequestModal');
      if (modal) {
        modal.style.display = 'none';
      }
    }

    function processReturn(action, itemId) {
      const modal = document.getElementById('returnRequestModal');
      const itemIds = modal.dataset.itemIds
        ? JSON.parse(modal.dataset.itemIds)
        : [];
      if (!modal) return;
      const orderId = modal.dataset.orderId;

      // Handle itemIds parameter correctly
      const payload = { action, itemIds: itemId ? [itemId] : itemIds };
      console.log("payload:", payload);

      fetch(`/admin/orders/${orderId}/verify-return`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(response => {
          console.log("response", response);
          if (!response.ok) throw new Error('Network response was not ok');
          return response.json();
        })
        .then(data => {
          if (data.error) {
            Swal.fire({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true, icon: 'error', title: `Error: ${data.error}` });
            return;
          }

          const row = document.querySelector(`tr[data-order-id="${orderId}"]`);
          if (!row) return;

          if (!itemId) {  // Full
            const returnCell = row.querySelector('td:nth-child(6)');
            if (returnCell) {
              returnCell.innerHTML = action.includes('approve')
                ? '<span class="return-approved">Full Return Approved</span>'
                : '<span class="return-rejected">Full Return Rejected</span>';
              const verifyBtn = returnCell.querySelector('.verify-btn');
              if (verifyBtn) verifyBtn.remove();
            }
          } else {  // Partial
            const itemRow = document.querySelector(`li[data-item-id="${itemId}"]`);
            if (itemRow) {
              itemRow.querySelector('.return-status').textContent = action.includes('approve') ? 'Approved' : 'Rejected';
            }
            const statusCell = row.querySelector('td:nth-child(6)');
            if (statusCell) {
              statusCell.innerHTML = `<span class="return-partial">${data.order?.returnDetails?.type === 'partial' ? 'Partially Returned' : 'Returned'}</span>`;
            }
          }

          showToast(`${itemId ? 'Item' : 'Order'} return ${action}ed successfully`);
        })
        .catch(error => {
          console.error('Error:', error);
          Swal.fire({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true, icon: 'error', title: `Failed to ${action} return request` });
        })
        .finally(() => {
          closeReturnModal();
        });
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = `toast ${type}`;
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => toast.classList.add('show'), 100);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }


  </script>
  <%- include('../partials/admin/admin-footer') %>