<%- include('../partials/admin/admin-header') %>
  <div class="page-header">
    <div class="page-title">
      <h1>Dashboard</h1>
      <p>Overview of your store performance</p>
    </div>

    <div class="breadcrumb">
      <a href="/admin/dashboard">Home</a>
      <span class="divider">/</span>
      <span>Dashboard</span>
    </div>
  </div>

  <!-- Dashboard Content -->
  <div class="dashboard-content">
    <!-- Dashboard Top Cards -->
    <div class="dashboard-stats">
      <div class="stat-card pink">
        <h4><i class="fas fa-users"></i> Total Users</h4>
        <p id="total-users">Loading...</p>
      </div>
      <div class="stat-card purple">
        <h4><i class="fas fa-box"></i> Items Sold</h4>
        <p id="items-sold">Loading...</p>
      </div>
      <div class="stat-card blue">
        <h4><i class="fas fa-rupee-sign"></i> Total Sales</h4>
        <p id="total-sales">Loading...</p>
      </div>
      <div class="stat-card violet">
        <h4><i class="fas fa-clock"></i> Pending Orders</h4>
        <p id="pending-orders">Loading...</p>
      </div>
      <button class="sales-report-btn" id="open-sales-report-modal">Sales Report <i class="fas fa-file-invoice"></i></button>
    </div>

    <!-- Sales Report Modal -->
    <div id="salesReportModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Sales Report</h2>
          <span class="close-modal">&times;</span>
        </div>
        <div class="modal-body">
          <!-- Report Controls -->
          <div class="report-controls">
            <div class="filter-group">
              <label for="modal-date-range">Date Range:</label>
              <select id="modal-date-range">
                <option value="1d">Today</option>
                <option value="1w">This Week</option>
                <option value="1m" selected>This Month</option>
                <option value="1y">This Year</option>
                <option value="custom">Custom Range</option>
              </select>
            </div>

            <div class="filter-group custom-date-range" id="modal-custom-date-range" style="display: none;">
              <label for="modal-start-date">From:</label>
              <input type="date" id="modal-start-date">
              <label for="modal-end-date">To:</label>
              <input type="date" id="modal-end-date">
            </div>

            <button class="apply-btn" id="modal-apply-filters">Apply Filters</button>
            <div class="export-buttons">
              <button class="export-btn pdf" id="modal-export-pdf">Export PDF <i class="fas fa-file-pdf"></i></button>
              <button class="export-btn excel" id="modal-export-excel">Export Excel <i class="fas fa-file-excel"></i></button>
            </div>
          </div>

          <!-- Report Summary Cards -->
          <div class="report-summary">
            <div class="summary-card">
              <h4>Total Orders</h4>
              <p id="modal-report-orders-count">0</p>
            </div>
            <div class="summary-card">
              <h4>Total Sales Amount</h4>
              <p id="modal-report-sales-amount">₹ 0</p>
            </div>
            <div class="summary-card">
              <h4>Total Discount</h4>
              <p id="modal-report-discount-amount">₹ 0</p>
            </div>
            <div class="summary-card">
              <h4>Net Revenue</h4>
              <p id="modal-report-net-revenue">₹ 0</p>
            </div>
          </div>

          <!-- Sales Report Table -->
          <div class="report-table-container">
            <table class="report-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Order ID</th>
                  <th>Customer</th>
                  <th>Items</th>
                  <th>Amount</th>
                  <th>Discount</th>
                  <th>Coupons</th>
                  <th>Payment Method</th>
                  <th>Net Amount</th>
                </tr>
              </thead>
              <tbody id="modal-sales-report-body">
                <tr>
                  <td colspan="9" class="loading-text">Select date range to view sales report</td>
                </tr>
              </tbody>
            </table>

            <div class="pagination" id="modal-report-pagination">
              <span class="page-prev">&lt;</span>
              <span class="page-number active">1</span>
              <span class="page-next">&gt;</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Sold Products Table -->
    <div class="dashboard-table">
      <h2>Top Sold Products</h2>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Product Image</th>
            <th>Product Name</th>
            <th>Amount</th>
            <th>Revenue</th>
            <th>Qty Sold</th>
          </tr>
        </thead>
        <tbody id="top-products-body">
          <tr>
            <td colspan="6" class="loading-text">Loading products...</td>
          </tr>
        </tbody>
      </table>

      <div class="pagination" id="products-pagination">
        <span class="page-prev">&lt;</span>
        <span class="page-number active">1</span>
        <span class="page-next">&gt;</span>
      </div>
    </div>

    <!-- Top Selling Categories Table -->
    <div class="dashboard-table">
      <h2>Top Selling Categories</h2>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Category Image</th>
            <th>Category Name</th>
            <th>Total Products</th>
            <th>Revenue</th>
            <th>Qty Sold</th>
          </tr>
        </thead>
        <tbody id="top-categories-body">
          <tr>
            <td colspan="6" class="loading-text">Loading categories...</td>
          </tr>
        </tbody>
      </table>
      <div class="pagination" id="categories-pagination"></div>
    </div>

    <div class="dashboard-chart">
      <div class="chart-header">
        <h2>Sales Overview</h2>
        <div class="period-selector">
          <button class="period-btn" data-period="daily">Daily</button>
          <button class="period-btn" data-period="weekly">Weekly</button>
          <button class="period-btn active" data-period="monthly">Monthly</button>
          <button class="period-btn" data-period="yearly">Yearly</button>
        </div>
      </div>
      <canvas id="salesChart"></canvas>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      console.log("dashboard.js loaded");

      document.addEventListener('DOMContentLoaded', function () {
        initDashboard();

        // Set up event listeners for modal sales report
        document.getElementById('modal-date-range').addEventListener('change', toggleModalCustomDateRange);
        document.getElementById('modal-apply-filters').addEventListener('click', applyModalReportFilters);
        document.getElementById('modal-export-pdf').addEventListener('click', exportModalPDFReport);
        document.getElementById('modal-export-excel').addEventListener('click', exportModalExcelReport);
        
        // Setup modal open/close
        document.getElementById('open-sales-report-modal').addEventListener('click', openSalesReportModal);
        document.querySelector('.close-modal').addEventListener('click', closeSalesReportModal);
        window.addEventListener('click', (event) => {
          const modal = document.getElementById('salesReportModal');
          if (event.target === modal) {
            closeSalesReportModal();
          }
        });

        // Setup generate report button to scroll to report section
        const generateBtn = document.getElementById('generate-report');
        if (generateBtn) {
          generateBtn.addEventListener('click', function() {
            document.querySelector('.sales-report-section').scrollIntoView({ behavior: 'smooth' });
          });
        }
        
        // Initialize modal with default filters
        initializeModalDefaults();

        // Initialize top categories
        fetchTopCategories(1);
      });

      function showNotification(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `toast-notification ${type}`;
        toast.innerText = message;
        Object.assign(toast.style, {
          position: 'fixed',
          bottom: '20px',
          right: '20px',
          padding: '10px 20px',
          backgroundColor: type === 'error' ? '#f44336' : '#4caf50',
          color: 'white',
          borderRadius: '5px',
          zIndex: 9999,
          boxShadow: '0 2px 10px rgba(0,0,0,0.2)'
        });
        document.body.appendChild(toast);
        setTimeout(function() { toast.remove(); }, 3000);
      }

      let currentPage = 1;
      let totalPages = 1;
      let salesChart = null;
      let reportCurrentPage = 1;
      let reportTotalPages = 1;
      let currentFilters = {
        dateRange: '1m',
        startDate: null,
        endDate: null
      };

      // Modal state
      let modalCurrentFilters = {
        dateRange: '1m',
        startDate: null,
        endDate: null
      };
      let modalReportCurrentPage = 1;
      let modalReportTotalPages = 1;

      function initializeModalDefaults() {
        document.getElementById('modal-date-range').value = '1m';
        toggleModalCustomDateRange();
        loadModalSalesReport(1);
      }

      function openSalesReportModal() {
        const modal = document.getElementById('salesReportModal');
        modal.style.display = 'block';
        document.body.style.overflow = 'hidden';
        loadModalSalesReport(modalReportCurrentPage);
      }

      function closeSalesReportModal() {
        const modal = document.getElementById('salesReportModal');
        modal.style.display = 'none';
        document.body.style.overflow = 'auto';
      }

      function toggleModalCustomDateRange() {
        const dateRange = document.getElementById('modal-date-range').value;
        const customDateRange = document.getElementById('modal-custom-date-range');

        if (dateRange === 'custom') {
          customDateRange.style.display = 'flex';
        } else {
          customDateRange.style.display = 'none';
        }
      }

      // Modal Apply Filters
      async function applyModalReportFilters() {
        const dateRange = document.getElementById('modal-date-range').value;
        let startDate = null;
        let endDate = null;

        if (dateRange === 'custom') {
          startDate = document.getElementById('modal-start-date').value;
          endDate = document.getElementById('modal-end-date').value;

          if (!startDate || !endDate) {
            showNotification('Please select both start and end dates', 'error');
            return;
          }

          if (new Date(startDate) > new Date(endDate)) {
            showNotification('Start date cannot be after end date', 'error');
            return;
          }
        }

        modalCurrentFilters = {
          dateRange: dateRange,
          startDate: startDate,
          endDate: endDate
        };

        await loadModalSalesReport(1);
      }

      // Modal Load Sales Report
      async function loadModalSalesReport(page = 1) {
        try {
          const tbody = document.getElementById('modal-sales-report-body');
          tbody.innerHTML = '<tr><td colspan="9" class="loading-text">Loading sales data...</td></tr>';

          // Build query parameters
          const params = new URLSearchParams({
            page: page,
            limit: 10,
            dateRange: modalCurrentFilters.dateRange
          });

          if (modalCurrentFilters.startDate) {
            params.append('startDate', modalCurrentFilters.startDate);
          }

          if (modalCurrentFilters.endDate) {
            params.append('endDate', modalCurrentFilters.endDate);
          }

          const response = await fetch('/admin/api/sales-report?' + params.toString());

          if (!response.ok) {
            throw new Error('HTTP error! status: ' + response.status);
          }

          const data = await response.json();
          tbody.innerHTML = '';

          if (data.orders && data.orders.length > 0) {
            data.orders.forEach(function(order) {
              const row = document.createElement('tr');
              row.innerHTML = 
                '<td>' + new Date(order.date).toLocaleDateString() + '</td>' +
                '<td>#' + order.orderId + '</td>' +
                '<td>' + order.customerName + '</td>' +
                '<td>' + order.itemsCount + '</td>' +
                '<td>₹' + (order.amount || 0).toLocaleString() + '</td>' +
                '<td>₹' + (order.discount || 0).toLocaleString() + '</td>' +
                '<td>' + (order.coupons || 'None') + '</td>' +
                '<td>' + (order.paymentMethod || 'N/A') + '</td>' +
                '<td>₹' + (order.netAmount || 0).toLocaleString() + '</td>';
              tbody.appendChild(row);
            });

            // Update summary cards
            document.getElementById('modal-report-orders-count').textContent = data.summary.totalOrders || 0;
            document.getElementById('modal-report-sales-amount').textContent = '₹ ' + (data.summary.totalSales || 0).toLocaleString();
            document.getElementById('modal-report-discount-amount').textContent = '₹ ' + (data.summary.totalDiscount || 0).toLocaleString();
            document.getElementById('modal-report-net-revenue').textContent = '₹ ' + (data.summary.netRevenue || 0).toLocaleString();
          } else {
            tbody.innerHTML = '<tr><td colspan="9" class="loading-text">No sales data found for the selected period</td></tr>';

            // Reset summary cards
            document.getElementById('modal-report-orders-count').textContent = '0';
            document.getElementById('modal-report-sales-amount').textContent = '₹ 0';
            document.getElementById('modal-report-discount-amount').textContent = '₹ 0';
            document.getElementById('modal-report-net-revenue').textContent = '₹ 0';
          }

          modalReportTotalPages = data.totalPages || 1;
          updateModalReportPagination(page);
        } catch (error) {
          console.error('Error loading modal sales report:', error);
          document.getElementById('modal-sales-report-body').innerHTML =
            '<tr><td colspan="9" class="error-text">Failed to load sales data</td></tr>';
          showNotification('Failed to load sales report', 'error');
        }
      }

      function updateModalReportPagination(currentPage) {
        const pagination = document.getElementById('modal-report-pagination');

        pagination.innerHTML = '';

        const prevButton = document.createElement('span');
        prevButton.className = 'page-prev';
        prevButton.innerHTML = '&lt;';
        prevButton.style.visibility = currentPage === 1 ? 'hidden' : 'visible';
        prevButton.addEventListener('click', function() { changeModalReportPage('prev'); });
        pagination.appendChild(prevButton);

        const pageNumbersContainer = document.createElement('div');
        pageNumbersContainer.className = 'page-numbers';

        for (let i = 1; i <= modalReportTotalPages; i++) {
          const pageSpan = document.createElement('span');
          pageSpan.className = 'page-number ' + (i === currentPage ? 'active' : '');
          pageSpan.textContent = i;
          pageSpan.addEventListener('click', function() { changeModalReportPage(i); });
          pageNumbersContainer.appendChild(pageSpan);
        }

        pagination.appendChild(pageNumbersContainer);

        const nextButton = document.createElement('span');
        nextButton.className = 'page-next';
        nextButton.innerHTML = '&gt;';
        nextButton.style.visibility = currentPage === modalReportTotalPages ? 'hidden' : 'visible';
        nextButton.addEventListener('click', function() { changeModalReportPage('next'); });
        pagination.appendChild(nextButton);
      }

      function changeModalReportPage(page) {
        if (page === 'prev') {
          if (modalReportCurrentPage > 1) {
            modalReportCurrentPage--;
          }
        } else if (page === 'next') {
          if (modalReportCurrentPage < modalReportTotalPages) {
            modalReportCurrentPage++;
          }
        } else {
          modalReportCurrentPage = page;
        }

        loadModalSalesReport(modalReportCurrentPage);
      }

      // Modal Export Functions
      async function exportModalPDFReport() {
        const pdfButton = document.getElementById('modal-export-pdf');
        const originalText = pdfButton.innerHTML;
        pdfButton.innerHTML = 'Generating... <i class="fas fa-spinner fa-spin"></i>';
        pdfButton.disabled = true;

        try {
          const params = new URLSearchParams({
            dateRange: modalCurrentFilters.dateRange,
            exportType: 'pdf'
          });

          if (modalCurrentFilters.startDate) {
            params.append('startDate', modalCurrentFilters.startDate);
          }

          if (modalCurrentFilters.endDate) {
            params.append('endDate', modalCurrentFilters.endDate);
          }

          const response = await fetch('/admin/api/export-sales-report?' + params.toString());

          if (!response.ok) {
            throw new Error('HTTP error! status: ' + response.status);
          }

          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.style.display = 'none';
          a.href = url;

          let filename = 'sales-report';
          if (modalCurrentFilters.dateRange === 'custom' && modalCurrentFilters.startDate && modalCurrentFilters.endDate) {
            filename = 'sales-report-' + modalCurrentFilters.startDate + '-to-' + modalCurrentFilters.endDate;
          } else {
            filename = 'sales-report-' + modalCurrentFilters.dateRange;
          }
          a.download = filename + '.pdf';

          document.body.appendChild(a);
          a.click();
          window.URL.revokeObjectURL(url);

          showNotification('PDF report generated successfully!', 'success');
        } catch (error) {
          console.error('Error generating PDF:', error);
          showNotification('Failed to generate PDF report', 'error');
        } finally {
          pdfButton.innerHTML = originalText;
          pdfButton.disabled = false;
        }
      }

      async function exportModalExcelReport() {
        const excelButton = document.getElementById('modal-export-excel');
        const originalText = excelButton.innerHTML;
        excelButton.innerHTML = 'Generating... <i class="fas fa-spinner fa-spin"></i>';
        excelButton.disabled = true;

        try {
          const params = new URLSearchParams({
            dateRange: modalCurrentFilters.dateRange,
            exportType: 'excel'
          });

          if (modalCurrentFilters.startDate) {
            params.append('startDate', modalCurrentFilters.startDate);
          }

          if (modalCurrentFilters.endDate) {
            params.append('endDate', modalCurrentFilters.endDate);
          }

          const response = await fetch('/admin/api/export-sales-report?' + params.toString());

          if (!response.ok) {
            throw new Error('HTTP error! status: ' + response.status);
          }

          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.style.display = 'none';
          a.href = url;

          let filename = 'sales-report';
          if (modalCurrentFilters.dateRange === 'custom' && modalCurrentFilters.startDate && modalCurrentFilters.endDate) {
            filename = 'sales-report-' + modalCurrentFilters.startDate + '-to-' + modalCurrentFilters.endDate;
          } else {
            filename = 'sales-report-' + modalCurrentFilters.dateRange;
          }
          a.download = filename + '.xlsx';

          document.body.appendChild(a);
          a.click();
          window.URL.revokeObjectURL(url);

          showNotification('Excel report generated successfully!', 'success');
        } catch (error) {
          console.error('Error generating Excel:', error);
          showNotification('Failed to generate Excel report', 'error');
        } finally {
          excelButton.innerHTML = originalText;
          excelButton.disabled = false;
        }
      }

      // Original functions (keep your existing code)
      async function initDashboard() {
        try {
          await Promise.all([
            loadStats(),
            loadTopProducts(),
            loadSalesChart()
          ]);
        } catch (error) {
          console.error('Error initializing dashboard:', error);
          showNotification('Failed to load dashboard data', 'error');
        }
      }

      async function loadStats() {
        try {
          const response = await fetch('/admin/api/stats');

          if (!response.ok) {
            throw new Error('HTTP error! status: ' + response.status);
          }

          const data = await response.json();

          document.getElementById('total-users').textContent = data.stats.totalUsers || 0;
          document.getElementById('items-sold').textContent = data.stats.itemsSold || 0;
          document.getElementById('total-sales').textContent = '₹ ' + (data.stats.totalSales || 0).toLocaleString();
          document.getElementById('pending-orders').textContent = data.stats.pendingOrders || 0;
        } catch (error) {
          console.error('Error loading stats:', error);
          document.getElementById('total-users').textContent = 'Error';
          document.getElementById('items-sold').textContent = 'Error';
          document.getElementById('total-sales').textContent = 'Error';
          document.getElementById('pending-orders').textContent = 'Error';
          showNotification('Failed to load statistics', 'error');
        }
      }

      async function loadTopProducts(page = 1) {
        try {
          const tbody = document.getElementById('top-products-body');
          tbody.innerHTML = '<tr><td colspan="6" class="loading-text">Loading products...</td></tr>';

          const response = await fetch('/admin/api/top-products?page=' + page + '&limit=4');

          if (!response.ok) {
            throw new Error('HTTP error! status: ' + response.status);
          }

          const data = await response.json();
          tbody.innerHTML = '';

          if (data.products && data.products.length > 0) {
            data.products.forEach(function(product) {
              const row = document.createElement('tr');
              row.innerHTML = 
                '<td>#' + product.id.toString().slice(-4) + '</td>' +
                '<td><img src="' + product.image + '" alt="' + (product.name || 'Product') + '" onerror="this.src=\'/images/placeholder.jpg\'"></td>' +
                '<td>' + (product.name || 'Unnamed Product') + '</td>' +
                '<td>₹' + (product.price || 0).toLocaleString() + '</td>' +
                '<td>₹' + (product.revenue || 0).toLocaleString() + '</td>' +
                '<td>' + (product.quantity || 0) + '</td>';
              tbody.appendChild(row);
            });
          } else {
            tbody.innerHTML = '<tr><td colspan="6" class="loading-text">No products found</td></tr>';
          }

          totalPages = data.totalPages || 1;
          updatePagination(page);
        } catch (error) {
          console.error('Error loading products:', error);
          document.getElementById('top-products-body').innerHTML =
            '<tr><td colspan="6" class="error-text">Failed to load products</td></tr>';
          showNotification('Failed to load products', 'error');
        }
      }

      function updatePagination(currentPage) {
        const pagination = document.getElementById('products-pagination');

        pagination.innerHTML = '';

        const prevButton = document.createElement('span');
        prevButton.className = 'page-prev';
        prevButton.innerHTML = '&lt;';
        prevButton.style.visibility = currentPage === 1 ? 'hidden' : 'visible';
        prevButton.addEventListener('click', function() { changePage('prev'); });
        pagination.appendChild(prevButton);

        const pageNumbersContainer = document.createElement('div');
        pageNumbersContainer.className = 'page-numbers';

        for (let i = 1; i <= totalPages; i++) {
          const pageSpan = document.createElement('span');
          pageSpan.className = 'page-number ' + (i === currentPage ? 'active' : '');
          pageSpan.textContent = i;
          pageSpan.addEventListener('click', function() { changePage(i); });
          pageNumbersContainer.appendChild(pageSpan);
        }

        pagination.appendChild(pageNumbersContainer);

        const nextButton = document.createElement('span');
        nextButton.className = 'page-next';
        nextButton.innerHTML = '&gt;';
        nextButton.style.visibility = currentPage === totalPages ? 'hidden' : 'visible';
        nextButton.addEventListener('click', function() { changePage('next'); });
        pagination.appendChild(nextButton);
      }

      function changePage(page) {
        if (page === 'prev') {
          if (currentPage > 1) {
            currentPage--;
          }
        } else if (page === 'next') {
          if (currentPage < totalPages) {
            currentPage++;
          }
        } else {
          currentPage = page;
        }

        loadTopProducts(currentPage);
      }

      let currentPeriod = 'monthly';
      
      async function loadSalesChart(period) {
        if (!period) period = currentPeriod;
        try {
          currentPeriod = period;
          const canvas = document.getElementById('salesChart');
          const chartContainer = canvas.parentElement;
          const existingError = chartContainer.querySelector('.error-text');
          if (existingError) {
            existingError.remove();
          }
          canvas.style.opacity = '0.5';
          const response = await fetch('/admin/api/sales-data?period=' + period);
          console.log("period inside the fetch sales chart", period);
          console.log("response inside the fetch sales chart", response);
          if (!response.ok) {
            throw new Error('HTTP error! status:' + response.status);
          }
          const data = await response.json();

          const ctx = canvas.getContext('2d');
          if (window.mySalesChart && typeof window.mySalesChart.destroy === 'function') {
            window.mySalesChart.destroy();
          }

          let chartLabel = '';
          let yAxisLabel = '';
          switch (period) {
            case 'daily':
              chartLabel = 'Daily Sales (₹)';
              yAxisLabel = 'Last 30 Days';
              break;
            case 'weekly':
              chartLabel = 'Weekly Sales (₹)';
              yAxisLabel = 'Last 12 Weeks';
              break;
            case 'monthly':
              chartLabel = 'Monthly Sales (₹)';
              yAxisLabel = 'Last 12 Months';
              break;
            case 'yearly':
              chartLabel = 'Yearly Sales (₹)';
              yAxisLabel = 'Sales by Year';
              break;
          }
          
          window.mySalesChart = new Chart(ctx, {
            type: 'line',
            data: {
              labels: data.labels || [],
              datasets: [{
                label: chartLabel,
                data: data.values || [],
                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 2,
                tension: 0.3,
                fill: true
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              plugins: {
                legend: {
                  position: 'top',
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      return '₹' + context.raw.toLocaleString();
                    }
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  title: {
                    display: true,
                    text: 'Sales Amount (₹)'
                  },
                  ticks: {
                    callback: function(value) {
                      return '₹' + value.toLocaleString();
                    }
                  }
                },
                x: {
                  title: {
                    display: true,
                    text: yAxisLabel
                  }
                }
              }
            }
          });

          canvas.style.opacity = '1';

        } catch (error) {
          console.error('Error loading sales chart:', error);
          const chartContainer = document.getElementById('salesChart').parentElement;
          const existingError = chartContainer.querySelector('.error-text');
          if (!existingError) {
            chartContainer.innerHTML += '<p class="error-text">Failed to load sales chart: ' + error.message + '</p>';
          }
          showNotification('Failed to load sales data', 'error');
        }
      }

      function setupPeriodButtons() {
        console.log('Setting up period buttons');
        const periodButtons = document.querySelectorAll('.period-btn');
        console.log('Found period buttons:', periodButtons.length);
        
        periodButtons.forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            const period = this.dataset.period;
            console.log('Period button clicked:', period);
            
            document.querySelectorAll('.period-btn').forEach(function(b) {
              b.classList.remove('active');
            });
            
            this.classList.add('active');
            
            loadSalesChart(period);
          });
        });
      }

      // Initialize chart and period buttons
      document.addEventListener('DOMContentLoaded', function() {
        console.log('DOM loaded - initializing chart...');
        loadSalesChart(currentPeriod);
        setupPeriodButtons();
      });

      // Top Selling Categories functionality
      let currentCategoryPage = 1;
      const CATEGORY_LIMIT = 4;

      async function fetchTopCategories(page = 1) {
        try {
          const response = await fetch('/admin/top-categories?page=' + page + '&limit=' + CATEGORY_LIMIT);
          if (!response.ok) throw new Error('Failed to fetch categories');
          
          const data = await response.json();
          console.log(data.currentPage);
          console.log(data.totalPages);
          renderCategories(data);
          renderCategoryPagination(data);
        } catch (error) {
          console.error('Error fetching top categories:', error);
          document.getElementById('top-categories-body').innerHTML = 
            '<tr><td colspan="6" class="error-text">Failed to load categories</td></tr>';
        }
      }

      function renderCategories(data) {
        const tbody = document.getElementById('top-categories-body');
        
        if (!data.categories || data.categories.length === 0) {
          tbody.innerHTML = 
            '<tr><td colspan="6" class="empty-text">No categories found</td></tr>';
          return;
        }

        tbody.innerHTML = data.categories.map(function(category) {
          return '<tr>' +
            '<td>' + category.id + '</td>' +
            '<td><img src="' + (category.image || '/images/default-category.png') + '" alt="' + category.name + '" class="category-image" onerror="this.src=\'/images/default-category.png\'"></td>' +
            '<td>' + category.name + '</td>' +
            '<td>' + (category.total_products || 0) + '</td>' +
            '<td>₹' + formatPrice(category.revenue || 0) + '</td>' +
            '<td>' + (category.quantity_sold || 0) + '</td>' +
            '</tr>';
        }).join('');
      }

      function renderCategoryPagination(data) {
        const pagination = document.getElementById('categories-pagination');
        const totalPages = data.totalPages || 1;
        const currentPage = data.currentPage || 1;

        let html = '';

        if (currentPage > 1) {
          html += '<span class="page-prev" onclick="changeCategoryPage(' + (currentPage - 1) + ')">&lt;&lt;</span>';
        } else {
          html += '<span class="page-prev disabled">&lt;&lt;</span>';
        }

        for (let i = 1; i <= totalPages; i++) {
          html += '<span class="page-number ' + (i === currentPage ? 'active' : '') + '" onclick="changeCategoryPage(' + i + ')">' + i + '</span>';
        }

        if (currentPage < totalPages) {
          html += '<span class="page-next" onclick="changeCategoryPage(' + (currentPage + 1) + ')">&gt;&gt;</span>';
        } else {
          html += '<span class="page-next disabled">&gt;&gt;</span>';
        }

        pagination.innerHTML = html;
      }

      function changeCategoryPage(page) {
        if (page < 1) return;
        currentCategoryPage = page;
        fetchTopCategories(page);
      }

      function formatPrice(amount) {
        return Number(amount).toFixed(2);
      }
    </script>

