    </div> <!-- Close content-wrapper -->
  </div> <!-- Close main-content -->

<script>
document.addEventListener('DOMContentLoaded', function () {
  const toggleSidebar = document.querySelector('.toggle-sidebar');
  const sidebar = document.querySelector('.sidebar');
  const hamburger = document.querySelector('.hamburger');

  if (toggleSidebar && sidebar) {
    toggleSidebar.addEventListener('click', function () {
      sidebar.classList.toggle('collapsed');
      this.classList.toggle('fa-chevron-left');
      this.classList.toggle('fa-chevron-right');
    });
  }

  if (hamburger && sidebar) {
    hamburger.addEventListener('click', function () {
      sidebar.classList.toggle('mobile-show');
    });
  }
});

</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const currentPath = window.location.pathname;

  // 1. Highlight active menu items dynamically based on URL path
  document.querySelectorAll('.sidebar-menu a').forEach(link => {
    const href = link.getAttribute('href');
    if (!href || href === '#') return;

    // Check if the current URL matches the link's href
    const isExactMatch = currentPath === href;
    const isSubPathMatch = currentPath.startsWith(href) && href !== '/admin/dashboard' && href !== '/admin';

    if (isExactMatch || isSubPathMatch) {
      link.classList.add('active');

      // If it is inside a submenu, activate the submenu container and its parent menu item
      const submenu = link.closest('.submenu');
      if (submenu) {
        submenu.classList.add('active');
        const parentHasSubmenu = submenu.closest('.has-submenu');
        if (parentHasSubmenu) {
          const parentLink = parentHasSubmenu.querySelector('.menu-item');
          if (parentLink) {
            parentLink.classList.add('active');
            const toggleIcon = parentLink.querySelector('.submenu-toggle');
            if (toggleIcon) {
              toggleIcon.classList.remove('fa-chevron-right');
              toggleIcon.classList.add('fa-chevron-down');
            }
          }
        }
      }
    }
  });

  // 2. Toggle submenus when clicking on the parent menu item itself
  document.querySelectorAll('.has-submenu > .menu-item').forEach(parentLink => {
    parentLink.addEventListener('click', function(e) {
      e.preventDefault();
      const parentContainer = this.closest('.has-submenu');
      const submenu = parentContainer.querySelector('.submenu');
      const toggleIcon = this.querySelector('.submenu-toggle');

      if (submenu) {
        submenu.classList.toggle('active');
      }
      if (toggleIcon) {
        toggleIcon.classList.toggle('fa-chevron-right');
        toggleIcon.classList.toggle('fa-chevron-down');
      }
    });
  });
});
</script>

<script>
(function () {
  const userProfile = document.querySelector('.user-profile');

  if (!userProfile) return; // Exit if element not found to avoid errors

  userProfile.addEventListener('click', function () {
    this.querySelector('.user-dropdown').classList.toggle('show');
  });

  // Close when clicking outside
  document.addEventListener('click', function (e) {
    if (!userProfile.contains(e.target)) {
      userProfile.querySelector('.user-dropdown').classList.remove('show');
    }
  });
})();

</script>
<% if (typeof pageJS !== 'undefined') { %>
   <script src="<%= pageJS %>"></script>
<% } %>



</body>
</html>